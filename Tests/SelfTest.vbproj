<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
  <RootNamespace>KiLabenSetup</RootNamespace><StartupObject>KiLabenSetup.TestRunner</StartupObject>
  <OptionStrict>On</OptionStrict><OptionExplicit>On</OptionExplicit><OptionInfer>On</OptionInfer>
 </PropertyGroup>
 <ItemGroup>
  <Compile Include="../KiLabenSetup/Models.vb" Link="Models.vb" />
  <Compile Include="../KiLabenSetup/Catalog.vb" Link="Catalog.vb" />
  <Compile Include="../KiLabenSetup/UrlPolicy.vb" Link="UrlPolicy.vb" />
 </ItemGroup>
</Project>
